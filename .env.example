# Copy this file to ".env" if you need to change a value.

# Where the FastAPI backend is running (used by the dev proxy).
VITE_BACKEND_URL=http://127.0.0.1:8000

# Base URL the browser calls. Keep "/api" in development (goes through the proxy).
# For a deployed build, set the full backend URL here (the backend then needs CORS).
VITE_API_BASE_URL=/api

# n8n chat trigger URL for the patient doctor assistant (production webhook of the
# "Doctor App - Doctor Search Assistant Chat" workflow, which must be published).
VITE_N8N_CHAT_URL=https://n8n-automation-n8n.zmsjji.easypanel.host/webhook/68f56aa3-8b9d-431f-859a-dc7eee335655/chat
